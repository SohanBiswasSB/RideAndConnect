# RideAndConnect — example environment.
# Copy to `.env` and edit. Never commit `.env`.

# ---- Runtime ----
APP_ENV=dev                       # dev | staging | prod
HTTP_ADDR=:8080
LOG_LEVEL=info                    # debug | info | warn | error

# ---- Database ----
DATABASE_URL=postgres://rideandconnect:rideandconnect@127.0.0.1:5432/rideandconnect?sslmode=disable

# ---- Auth ----
JWT_SECRET=                       # REQUIRED in prod, ≥ 32 bytes random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
WS_TICKET_TTL=5m

# ---- GraphQL ----
GRAPHQL_DEPTH_LIMIT=8
GRAPHQL_COMPLEXITY_LIMIT=200
GRAPHQL_INTROSPECTION=auto        # auto | on | off (auto = on outside prod)

# ---- Route provider — choose one ----
ROUTE_PROVIDER=google             # google | mapbox

# Google Routes API v2
GOOGLE_ROUTES_API_KEY=            # REQUIRED if ROUTE_PROVIDER=google
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com

# Mapbox Directions API v5
MAPBOX_ACCESS_TOKEN=              # REQUIRED if ROUTE_PROVIDER=mapbox
MAPBOX_BASE_URL=https://api.mapbox.com
MAPBOX_PROFILE_TWO_WHEELER=cycling   # cycling | driving (set driving for motorcycle apps)
MAPBOX_PROFILE_BICYCLE=cycling
MAPBOX_PROFILE_WALK=walking

# Cache, throttling, peer-route
ROUTE_CACHE_TTL=30m
ROUTE_RATE_USER=1/30s
ROUTE_RATE_RIDE=6/10m
PEER_ROUTE_CACHE_TTL=60s
PEER_ROUTE_STALE_TTL=30s
PEER_ROUTE_RATE_PAIR=1/30s
PEER_ROUTE_RATE_RIDE=12/10m

# ---- WebSocket / wire / QoS ----
WS_DEFAULT_CODEC=toon             # toon | json
WS_PERMESSAGE_DEFLATE=true
WS_PING_INTERVAL=25s              # high/medium tier
WS_PING_INTERVAL_LOW=30s
WS_PING_INTERVAL_CRITICAL=60s
WS_IDLE_TIMEOUT=60s
WS_MAX_MSG_SIZE=8192              # decoded
WS_MAX_WIRE_BYTES=16384           # compressed
WS_TIER_RTT_HIGH_MS=250
WS_TIER_RTT_LOW_MS=600
WS_TIER_RTT_CRITICAL_MS=1500
WS_LOC_HZ_HIGH=2
WS_LOC_HZ_MEDIUM=1
WS_LOC_HZ_LOW=0.5
WS_LOC_HZ_CRITICAL=0.2

# ---- HTTP / CORS / rate limit ----
HTTP_COMPRESSION=gzip,br
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_RPS=20

# ---- Privacy / feature flags ----
LOCATION_PERSIST=false

# When true, X-Forwarded-For / X-Real-Ip are honored when reading the
# client IP for rate limiting and access logs. Enable ONLY when the API
# is behind a known reverse proxy that strips/replaces these headers
# (Caddy, NGINX, ALB, Cloudflare). With direct internet exposure, leave
# false so attackers can't spoof their source IP.
TRUST_PROXY_HEADERS=false
